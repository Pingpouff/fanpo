{
  "tasks": {
    "cli": "DENO_SQLITE_PATH=.data/sqlite3 deno run --env-file=.env --no-prompt --allow-env=FANTASY_TOKEN,FANTASY_API_URL,DENO_SQLITE_PATH,DENO_SQLITE_LOCAL --allow-net=fantasy.poneeey.fr:443 --allow-read=.data --allow-write=.data --allow-ffi src/cli.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "check": "deno fmt --check && deno lint && deno check src/cli.ts src/client.ts src/types.ts src/filters.ts tests/*.ts",
    "test": "DENO_SQLITE_PATH=.data/sqlite3 deno test --allow-env=DENO_SQLITE_PATH,DENO_SQLITE_LOCAL,FANTASY_API_URL --allow-ffi --allow-read=.data,/tmp --allow-write=.data,/tmp",
    "sqlite:setup": "deno run --no-prompt --allow-read=.data,/lib,/usr/lib --allow-write=.data --allow-ffi=.data --allow-net=github.com,release-assets.githubusercontent.com src/data/setup.ts"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@1.3.1",
    "@db/sqlite": "jsr:@db/sqlite@0.13.0"
  },
  "fmt": {
    "include": [
      "src",
      "tests",
      "deno.json",
      "README.md",
      "docs/plans",
      "regles_fantasy_rugby.md"
    ]
  },
  "lint": {
    "include": [
      "src",
      "tests"
    ]
  }
}
